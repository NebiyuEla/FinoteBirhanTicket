+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { TicketDatabase } from '../src/db.js';
+
+function makeDb() {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'finote-core-routing-'));
+  const db = new TicketDatabase(path.join(dir, 'test.sqlite'), { reservationMinutes: 10, manualReviewMinutes: 30 });
+  db.ensureUser(1); db.setUserName(1, 'Buyer One'); db.setUserPhone(1, '+251911111111');
+  db.ensureUser(2); db.setUserName(2, 'Seller One'); db.setUserPhone(2, '+251922222222');
+  db.ensureUser(999); db.setUserName(999, 'Admin'); db.setUserPhone(999, '+251933333333'); db.addAdmin(999);
+  const seller = db.activateSellerRole(2, 999).seller;
+  return { db, dir, seller };
+}
+
+function close(db, dir) {
+  db.close();
+  fs.rmSync(dir, { recursive: true, force: true });
+}
+
+test('main-menu navigation is routed before persisted wizard state', () => {
+  const source = fs.readFileSync(new URL('../src/index.js', import.meta.url), 'utf8');
+  const route = source.indexOf('if (await handleMainMenuNavigation(telegramId, text)) return;');
+  const stateRead = source.indexOf('const state = db.getUserState(telegramId);', route);
+  assert.ok(route > 0, 'navigation guard must exist');
+  assert.ok(stateRead > route, 'navigation must run before state handling');
+  assert.match(source, /db\.clearUserState\(telegramId\);[\s\S]*const activatedSeller = db\.activateSellerIfInvited/);
+});
+
+test('historical menu-label corruption in seller payment account is repaired safely', () => {
+  const { db, dir, seller } = makeDb();
+  db.db.prepare('UPDATE sellers SET payment_provider=?,account_name=?,account_number=? WHERE id=?')
+    .run('📈 Seller Stats', '📈 Seller Stats', '📈 Seller Stats', seller.id);
+  assert.equal(db.repairCorruptedSellerAccounts(), 1);
+  const fixed = db.getSellerById(seller.id);
+  assert.equal(fixed.payment_provider, '');
+  assert.equal(fixed.account_name, '');
+  assert.equal(fixed.account_number, '');
+  close(db, dir);
+});
+
+test('core recovery queue includes recent expired purchases and can safely restore them', () => {
+  const { db, dir } = makeDb();
+  const purchase = db.reservePurchase({ telegramId: 1, packageType: '50', selectedNumbers: { 50: 87 } });
+  db.submitPaymentProof(purchase.id, { reference: 'CORE-RECOVERY-87' });
+  db.db.prepare("UPDATE purchases SET reserved_until='2000-01-01T00:00:00.000Z' WHERE id=?").run(purchase.id);
+  db.db.prepare("UPDATE ticket_numbers SET reserved_until='2000-01-01T00:00:00.000Z' WHERE purchase_id=?").run(purchase.id);
+  db.releaseExpiredReservations();
+  db.db.prepare('UPDATE purchases SET reserved_until=? WHERE id=?').run(new Date().toISOString(), purchase.id);
+
+  assert.ok(db.recoveryQueue().some((row) => row.id === purchase.id && row.status === 'expired'));
+  const paid = db.recoverExpiredPurchase(purchase.id, 999, { note: 'Recovered after outage.' });
+  assert.equal(paid.status, 'paid');
+  assert.equal(db.getTicketNumberDetails(50, 87).status, 'sold');
+  close(db, dir);
+});
+
+test('build exposes an explicit /version command and Recovery admin UI', () => {
+  const source = fs.readFileSync(new URL('../src/index.js', import.meta.url), 'utf8');
+  assert.match(source, /const BOT_BUILD = '1\.3\.5';/);
+  assert.match(source, /if \(cmd === '\/version'\)/);
+  assert.match(source, /Recovery attention:/);
+  assert.match(source, /text: '🚨 Recovery'/);
+});
